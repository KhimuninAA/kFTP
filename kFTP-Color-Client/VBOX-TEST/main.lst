 5592 1581              ; 500 /// A - код операции
 5593 1581              ; 501 /// ------ Структура ---------------
 5594 1581              ; 502 /// 1 byte : Action
 5595 1581              ; 503 /// 2 byte : Next (0x01 = Next; 0x5A - Stop)
 5596 1581              ; 504 /// 3..10 bytes : Data
 5597 1581              ; 505 /// 11 byte : SUM
